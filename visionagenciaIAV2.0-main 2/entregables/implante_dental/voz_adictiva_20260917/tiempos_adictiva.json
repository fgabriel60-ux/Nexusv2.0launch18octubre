{
 "guion": [
  {
   "inicio_s": 0.1,
   "nombre": "HOOK",
   "texto": "¿Te falta un diente? Esto es lo que pasa por dentro."
  },
  {
   "inicio_s": 5.1,
   "nombre": "ANESTESIA",
   "texto": "Empieza con anestesia. No duele: ni lo vas a sentir."
  },
  {
   "inicio_s": 10.1,
   "nombre": "ADENTRO",
   "texto": "Y aquí está lo que nadie te enseña."
  },
  {
   "inicio_s": 15.1,
   "nombre": "PREPARA",
   "texto": "El dentista abre un espacio en el hueso, justo donde estaba tu raíz."
  },
  {
   "inicio_s": 20.1,
   "nombre": "TITANIO",
   "texto": "Ahí entra un tornillo de titanio. Esa va a ser tu nueva raíz."
  },
  {
   "inicio_s": 25.1,
   "nombre": "INTEGRA",
   "texto": "Con los meses tu hueso crece alrededor y lo deja firme."
  },
  {
   "inicio_s": 30.1,
   "nombre": "CORONA",
   "texto": "Encima, una corona igual a tus dientes."
  },
  {
   "inicio_s": 33.1,
   "nombre": "SONRISA",
   "texto": "Y vuelves a sonreír."
  }
 ],
